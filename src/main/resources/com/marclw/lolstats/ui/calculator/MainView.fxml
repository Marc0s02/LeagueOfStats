<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.marclw.lolstats.ui.calculator.MainController">
    <top>
        <Label text="Champion Comparison" style="-fx-font-size: 18px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="10" right="10" bottom="0" left="10" />
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15" />
            </padding>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Champion A" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="championABox" maxWidth="Infinity" />
                <Label text="Level" />
                <Spinner fx:id="levelASpinner" editable="true" />
                <Label text="Items (ctrl/cmd-click to select multiple)" />
                <ListView fx:id="itemsAListView" prefHeight="150" />
                <Label text="Final Stats:" style="-fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets top="10" />
                    </VBox.margin>
                </Label>
                <Label fx:id="statsALabel" wrapText="true" />
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Champion B" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="championBBox" maxWidth="Infinity" />
                <Label text="Level" />
                <Spinner fx:id="levelBSpinner" editable="true" />
                <Label text="Items (ctrl/cmd-click to select multiple)" />
                <ListView fx:id="itemsBListView" prefHeight="150" />
                <Label text="Final Stats:" style="-fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets top="10" />
                    </VBox.margin>
                </Label>
                <Label fx:id="statsBLabel" wrapText="true" />
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <Button text="Compare" onAction="#onCompare" />
            <!-- Hands off to ViewManager.showPredictionView() -->
            <Button fx:id="switchToPredictionButton" text="Switch to Match Prediction"
                    onAction="#onSwitchToPrediction" />
        </HBox>
    </bottom>
</BorderPane>