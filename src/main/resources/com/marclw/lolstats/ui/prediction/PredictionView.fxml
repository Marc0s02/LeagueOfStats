<?xml version="1.0" encoding="UTF-8"?>

<!--
    NOTE ON LOCATION: this file lives at
      resources/com/marclw/lolstats/ui/prediction/PredictionView.fxml
    which is what ViewManager.showPredictionView() actually loads. The old
    placeholder was one directory up (.../lolstats/prediction/), missing the
    "ui" segment, so the loader resolved null and threw. Delete that old file.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.marclw.lolstats.ui.prediction.PredictionController"
            prefWidth="760" prefHeight="560">
    <top>
        <VBox spacing="4">
            <padding>
                <Insets top="12" right="15" bottom="4" left="15" />
            </padding>
            <Label text="Match Win Prediction" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label text="Scores a finished match as if the game were paused at the chosen minute."
                   style="-fx-text-fill: #666666;" />
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15" />
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Match ID" />
                <TextField fx:id="matchIdField" promptText="EUW1_7975080416" prefWidth="240" />
                <Label text="Through minute" />
                <Spinner fx:id="minuteSpinner" editable="true" prefWidth="90" />
                <Button fx:id="predictButton" text="Predict" onAction="#onPredictButtonClicked"
                        defaultButton="true" />
            </HBox>

            <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #444444;" />

            <VBox spacing="6">
                <Label text="Win probability at selected minute" style="-fx-font-weight: bold;" />
                <ProgressBar fx:id="blueProbabilityBar" prefWidth="Infinity" prefHeight="22"
                             progress="0" />
                <HBox spacing="20">
                    <Label fx:id="blueProbabilityLabel" text="Blue: -" />
                    <Label fx:id="redProbabilityLabel" text="Red:  -" />
                </HBox>
            </VBox>

            <Label text="Probability over time" style="-fx-font-weight: bold;" />
            <LineChart fx:id="probabilityChart" legendVisible="true" createSymbols="false"
                       VBox.vgrow="ALWAYS">
                <xAxis>
                    <NumberAxis label="Minute" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Blue win probability" lowerBound="0" upperBound="1"
                                autoRanging="false" tickUnit="0.1" />
                </yAxis>
            </LineChart>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="8" right="15" bottom="12" left="15" />
            </padding>
            <!-- Hands off to ViewManager.showCalculatorView() -->
            <Button fx:id="switchToCalculatorButton" text="Back to Stat Calculator"
                    onAction="#onSwitchToCalculator" />
            <Button fx:id="switchToAdvisorButton" text="Open Advisor"
                    onAction="#onSwitchToAdvisor" />
        </HBox>
    </bottom>
</BorderPane>
