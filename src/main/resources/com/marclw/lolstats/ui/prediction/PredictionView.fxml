<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.marclw.lolstats.ui.prediction.PredictionController"
            styleClass="app-root">

    <top>
        <VBox styleClass="top-bar">
            <padding>
                <Insets top="16" right="22" bottom="14" left="22"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="LEAGUEOFSTATS" styleClass="brand-label"/>
                <Label text="MATCH PREDICTION" styleClass="brand-subtitle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="SUMMONER'S RIFT" styleClass="mode-pill"/>
            </HBox>
            <HBox spacing="8" styleClass="navigation-row">
                <Button text="Calculator" onAction="#onSwitchToCalculator" styleClass="nav-button"/>
                <Button text="Match Prediction" styleClass="nav-button-active"/>
                <Button text="Build Advisor" onAction="#onSwitchToAdvisor" styleClass="nav-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll">
            <VBox spacing="18">
                <padding>
                    <Insets top="20" right="22" bottom="20" left="22"/>
                </padding>

                <VBox styleClass="selector-panel" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="2">
                            <Label text="MATCH ID" styleClass="small-label"/>
                            <TextField fx:id="matchIdField" promptText="EUW1_7975080416"
                                       prefWidth="240" styleClass="search-field"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="THROUGH MINUTE" styleClass="small-label"/>
                            <Spinner fx:id="minuteSpinner" editable="true" prefWidth="90"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="predictButton" text="Predict" defaultButton="true"
                                onAction="#onPredictButtonClicked" styleClass="primary-button"/>
                    </HBox>
                    <Label fx:id="statusLabel" text="Enter a match ID and press Predict."
                           wrapText="true" styleClass="section-subtitle"/>
                </VBox>

                <HBox spacing="16">
                    <VBox styleClass="detail-panel" prefWidth="340" spacing="10">
                        <Label text="WIN PROBABILITY" styleClass="section-title"/>
                        <ProgressBar fx:id="blueProbabilityBar" progress="0" prefWidth="Infinity"
                                     prefHeight="26" styleClass="probability-bar"/>
                        <HBox spacing="20">
                            <Label fx:id="blueProbabilityLabel" text="Blue: -" styleClass="team-title-blue"/>
                            <Label fx:id="redProbabilityLabel" text="Red: -" styleClass="team-title-red"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="detail-panel" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="BASED ON" styleClass="section-title"/>
                        <Label text="State at the selected minute - the six live signals the model actually uses today."
                               wrapText="true" styleClass="section-subtitle"/>
                        <Label fx:id="predictionBasisLabel" text="—" styleClass="stats-label"/>
                    </VBox>
                </HBox>

                <VBox styleClass="detail-panel" spacing="10">
                    <Label text="PROBABILITY OVER TIME" styleClass="section-title"/>
                    <LineChart fx:id="probabilityChart" legendVisible="false" createSymbols="false"
                               prefHeight="320" styleClass="probability-chart">
                        <xAxis>
                            <NumberAxis label="Minute"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Blue win probability" lowerBound="0" upperBound="1"
                                        autoRanging="false" tickUnit="0.1"/>
                        </yAxis>
                    </LineChart>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>